\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Máximo módulo de los polos de lazo cerrado \emph  {evaluados sobre el modelo lineal nominal alrededor de $\theta =0$} (con el regulador final) y convergencia (desvío de $s_0$ en la ventana final). El gate del modo robusto sólo verifica estabilidad frente a este modelo nominal, no frente a la planta real desconocida.}}{11}{table.caption.8}\protected@file@percent }
\newlabel{tab:conv}{{2}{11}{Máximo módulo de los polos de lazo cerrado \emph {evaluados sobre el modelo lineal nominal alrededor de $\theta =0$} (con el regulador final) y convergencia (desvío de $s_0$ en la ventana final). El gate del modo robusto sólo verifica estabilidad frente a este modelo nominal, no frente a la planta real desconocida}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Desvío estándar de $s_0$ en la ventana final (escala log). El modo robusto (azul, prácticamente nulo) converge en todos los escenarios; el básico (rojo) no converge con perturbación sinusoidal ni con ruido.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:conv}{{4}{11}{Desvío estándar de $s_0$ en la ventana final (escala log). El modo robusto (azul, prácticamente nulo) converge en todos los escenarios; el básico (rojo) no converge con perturbación sinusoidal ni con ruido}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Sinusoidal (los dos casos que más cambian).}{11}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Perturbación sinusoidal: básico vs robusto. Arriba: $\theta $ en régimen (con RMS) y control $u$. Abajo: coeficientes de $S$ (básico en trazo punteado, diverge; robusto sólido, constante) y radio de polos de LC (el básico sube a $0{,}989$; el robusto se mantiene en $0{,}942$).}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:cmpdet_sin}{{5}{12}{Perturbación sinusoidal: básico vs robusto. Arriba: $\theta $ en régimen (con RMS) y control $u$. Abajo: coeficientes de $S$ (básico en trazo punteado, diverge; robusto sólido, constante) y radio de polos de LC (el básico sube a $0{,}989$; el robusto se mantiene en $0{,}942$)}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{Ruido de medición.}{12}{section*.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ruido de medición: básico vs robusto. El regulador básico persigue el ruido ($S$ oscila y el radio de polos supera $|z|=1$ en varios instantes); el robusto se estabiliza en el diseño nominal y regula mucho mejor a $\theta $.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cmpdet_rui}{{6}{13}{Ruido de medición: básico vs robusto. El regulador básico persigue el ruido ($S$ oscila y el radio de polos supera $|z|=1$ en varios instantes); el robusto se estabiliza en el diseño nominal y regula mucho mejor a $\theta $}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5}Demostración con planta distinta a priori}{13}{subsection.0.7.5}\protected@file@percent }
\newlabel{sec:selftuning}{{7.5}{13}{Demostración con planta distinta a priori}{subsection.0.7.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Caso 1: Carrito $50\%$ más pesado (cambia la ganancia).}{13}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Autoajuste ante un carro $50\%$ más pesado. Estimados (línea continua) parten del prior nominal (punteado) y van hacia la planta real (guiones): $b$ converge al real; $a_1$ (eje ampliado) casi no cambia porque la masa apenas afecta los polos. El regulador $S$ se rediseña hacia el diseño de la planta real.}}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:selftuning}{{7}{14}{Autoajuste ante un carro $50\%$ más pesado. Estimados (línea continua) parten del prior nominal (punteado) y van hacia la planta real (guiones): $b$ converge al real; $a_1$ (eje ampliado) casi no cambia porque la masa apenas afecta los polos. El regulador $S$ se rediseña hacia el diseño de la planta real}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {paragraph}{Caso 2: barra $10\%$ más larga (cambian los polos y la ganancia).}{14}{section*.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Autoajuste ante una barra $10\%$ más larga. A diferencia del caso de masa, ahora \textbf  {$a_1$ sí se mueve} (eje ampliado) desde el prior nominal hacia la planta real, junto con $b$; el regulador $S$ converge al diseño de la planta real.}}{15}{figure.caption.17}\protected@file@percent }
\newlabel{fig:selftuning_l}{{8}{15}{Autoajuste ante una barra $10\%$ más larga. A diferencia del caso de masa, ahora \textbf {$a_1$ sí se mueve} (eje ampliado) desde el prior nominal hacia la planta real, junto con $b$; el regulador $S$ converge al diseño de la planta real}{figure.caption.17}{}}
